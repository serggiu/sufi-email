#!/usr/bin/env bash
# Run all tests for the Sufi Email project.
#
# - Rust unit + integration tests in src-tauri (config/crypto/store units,
#   the fake-IMAP integration suite, and the manual send check).
# - Frontend tests with vitest (src/lib/*.test.js).
#
# Usage:
#   bin/test                 # run everything
#   bin/test <filter>        # run only matching Rust tests (cargo test filter)
#   bin/test -- --nocapture  # pass extra args through to cargo test

set -euo pipefail

# Project root = one directory above this script's location (bin/).
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

echo "==> Running Rust tests (src-tauri): cargo test $*"
cd "$ROOT/src-tauri"
cargo test "$@"

echo "==> Running frontend tests: npm test"
cd "$ROOT"
npm test
