{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sufi Email",
  "version": "0.1.0",
  "identifier": "com.sufi.email",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Sufi Email",
        "width": 1280,
        "height": 800,
        "minWidth": 700,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  }
}
